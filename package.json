{
  "name": "@accessible-by-default/checks",
  "version": "0.1.0",
  "description": "Playwright matchers that operate a page's widgets by keyboard in Chromium, Firefox and WebKit and check they behave as they claim: expanded state, modal focus, and errors tied to their fields.",
  "license": "MIT",
  "author": "Thomas Sweet",
  "homepage": "https://github.com/ThomasSweet/behaviour-checks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThomasSweet/behaviour-checks.git"
  },
  "bugs": "https://github.com/ThomasSweet/behaviour-checks/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "accessibility",
    "a11y",
    "playwright",
    "wcag",
    "aria-expanded",
    "dialog",
    "focus"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.16.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc",
    "test": "playwright test",
    "test:site": "SITE_DIR=../a11y-foundation playwright test tests/site.spec.ts",
    "check:package": "node scripts/check-package.mjs"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.64.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3"
  }
}
